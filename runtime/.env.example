# Generate a random value with `openssl rand -hex 32` on Linux or the
# RandomNumberGenerator API in PowerShell on Windows.
MCP_PATH_SECRET=replace-with-a-random-secret
CODE_ROOT=/path/to/projects
PORT=8787

# Latency safeguards for the Notion inference bridge. Higher values can be
# chosen for unusually long high/ultra-reasoning tasks.
NOTION_INFERENCE_TIMEOUT_SECONDS=180
NOTION_POOL_RECOVERY_WAIT_SECONDS=8
NOTION_MAX_RECOVERY_CYCLES=1
NOTION_SINGLE_ACCOUNT_TRANSIENT_COOLDOWN_SECONDS=1
# Optional comma-separated account filenames that benchmark faster with
# Notion's legacy cumulative response stream instead of patch responses.
NOTION_LEGACY_RESPONSE_ACCOUNT_FILES=
