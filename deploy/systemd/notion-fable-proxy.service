[Unit]
Description=Unified Notion AI bridge and coding MCP runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Environment=HOME=__USER_HOME__
Environment=NOTION_AGENT_HOME=__USER_HOME__/.notionagents
Environment=NOTION_FABLE_PORT=8765
WorkingDirectory=__NOTIONCODE_ROOT__
ExecStart=/usr/bin/env node __NOTIONCODE_ROOT__/bridge/server.js
Restart=on-failure
RestartSec=3
EnvironmentFile=__NOTIONCODE_ROOT__/runtime/.env

[Install]
WantedBy=multi-user.target
